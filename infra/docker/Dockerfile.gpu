# ── GPU inference server (CUDA 12.1 + Python 3.11) ───────────────────────────
# Requires a GPU node. For CPU-only testing set DEVICE=cpu in env.
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime AS base

WORKDIR /app

# System deps (ffmpeg for audio processing)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    curl \
  && rm -rf /var/lib/apt/lists/*

# Python deps
COPY backend/gpu-server/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install ACE-Step 1.5 from source (music generation)
RUN pip install --no-cache-dir \
    git+https://github.com/ace-step/ACE-Step.git

COPY backend/gpu-server/ ./

# Non-root user
RUN useradd -m -u 1001 gpuuser && chown -R gpuuser /app
USER gpuuser

EXPOSE 8000

HEALTHCHECK --interval=60s --timeout=15s --start-period=120s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
