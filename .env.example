VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend API base URL (defaults to http://localhost:3001 in dev)
VITE_API_URL=http://localhost:3001

# S3 bucket for constructing public asset URLs in the browser
VITE_S3_BUCKET=storyweave-renders
VITE_AWS_REGION=us-east-1

# ─── Sprint 6: Social Media OAuth ────────────────────────────────────────────
# (VITE_ prefix = exposed to frontend for constructing auth URLs only)
# (Non-VITE_ = server-side only — set in Supabase Edge Function secrets + backend .env)

# Frontend: public client IDs used to build the authorization URL
VITE_TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
VITE_META_APP_ID=YOUR_META_APP_ID

# App URL — used by OAuth callbacks to redirect back to the publisher page
APP_URL=https://app.storyweave.ai

# TikTok Content Posting API
# Register at: https://developers.tiktok.com → Content Posting API
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT.supabase.co/functions/v1/social-oauth?platform=tiktok

# Google / YouTube Data API v3
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT.supabase.co/functions/v1/social-oauth?platform=youtube

# Meta / Instagram Graph API
# Create app at: https://developers.facebook.com → My Apps
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=https://YOUR_SUPABASE_PROJECT.supabase.co/functions/v1/social-oauth?platform=instagram

# Supabase service role key (used by backend to bypass RLS for token storage)
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
